{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Humla",
  "version": "0.74.1-fork.12.1",
  "identifier": "no.humla.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Humla",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/audio-capture",
      "binaries/speaker-diarize",
      "binaries/humla-mcp",
      "binaries/humla-gigaam"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "humla"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/AlexeyVatolin/humla/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNTZEMTlFMzAzN0ZDQjAKUldTdy9EY3dudEZXTTR5Qy9GVDRkTjduMVRyaUIyWk4reE9HUjl0VHlnbVRuTzJkektsN3NqdkUK"
    }
  }
}

{
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "Humla",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/audio-capture",
      "binaries/speaker-diarize",
      "binaries/humla-mcp"
    ],
    "resources": {
      "target/windows-runtime/lib/*.dll": ".",
      "target/windows-runtime/lib/*LICENSE*": "licenses"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
